# ==============================================================================
# Binance Spot Quantitative Swing Trading Engine - Configuration Template
# Copy this file to .env and adjust parameters as needed.
# ==============================================================================

# Exchange Endpoint
# Production: https://api.binance.com
# Market Data Only (Public): https://data-api.binance.vision
# Testnet: https://testnet.binance.vision
BINANCE_BASE_URL=https://data-api.binance.vision

# Binance API Credentials (leave empty or use test keys for Paper Trading)
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET_HERE

# Optional Binance Spot Testnet Credentials (if testing real order placement on testnet)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Live Trading Safety Switches (fail-closed default: false)
# Live trading requires ENABLE_LIVE_TRADING=true and CONFIRM_LIVE_TRADING=YES_I_ACCEPT_RISK
ENABLE_LIVE_TRADING=false
CONFIRM_LIVE_TRADING=

# Strategy Universe Configuration
SCAN_ALL_USDT_SPOT=true
QUOTE_ASSET=USDT
MIN_24H_QUOTE_VOLUME_USDT=1000000
SCAN_BATCH_SIZE=15
TICKER_REFRESH_SECONDS=900
UNIVERSE_REFRESH_SECONDS=21600
EQUITY_CHANGE_REVIEW_THRESHOLD_USDT=1.0

# Manual Symbol Fallback (used when SCAN_ALL_USDT_SPOT=false)
SYMBOLS=BTCUSDT,ETHUSDT

# Fee-Reserve Asset Exclusion (deducted from strategy equity calculations; BNB Spot balance)
EXCLUDED_SYMBOLS=BNBUSDT

# Chronic Fakeout Scanner Blacklist (excluded from scanner universe)
BLACKLISTED_SYMBOLS=ICPUSDT,FILUSDT,CRVUSDT,ATOMUSDT

# Market-Context Quantitative Gates
ENABLE_BTC_REGIME_GATE=true
ENABLE_RS_FILTER=true
ENABLE_15M_FILTER=false
MIN_SCORECARD_POINTS=90

# Quantitative Risk & Exit Controls
EXIT_MODE=FIXED_TP
TAKE_PROFIT_PCT=2.0
MIN_STOP_PCT=1.5
MAX_STOP_PCT=2.5
MAX_HOLD_HOURS=0

# Capital & Exposure Management
RISK_PER_TRADE_PCT=2
TRADE_NOTIONAL_USDT=20
ENTRY_ORDER_TIMEOUT_SECONDS=300
MAX_POSITION_PCT=10
MAX_TOTAL_EXPOSURE_PCT=60
MIN_CASH_RESERVE_PCT=40
MAX_OPEN_POSITIONS=5

# Drawdown & Loss Circuit Breakers
DAILY_LOSS_LIMIT_PCT=2
WEEKLY_LOSS_LIMIT_PCT=4
MAX_DRAWDOWN_PCT=8
MAX_ENTRY_SLIPPAGE_PCT=0.10
POLL_SECONDS=15

# Real-Time Web Dashboard Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8767

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
